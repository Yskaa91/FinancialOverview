DATABASE_URL="file:./dev.db"

# Optional: AI category suggestions (Mistral chat completions).
# AI_PROVIDER=mistral  AI_API_KEY=...  AI_MODEL=mistral-small-latest
# AI_MAX_BATCHES caps the API calls per run (default 5, 40 transactions each).
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=mistral-small-latest
AI_MAX_BATCHES=5

# Optional: refreshes ETF prices from Stooq (keyless) for broker accounts.
PRICE_FETCH=disabled
