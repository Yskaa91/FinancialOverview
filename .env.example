DATABASE_URL="file:./dev.db"

# Optional: AI category suggestions (Mistral chat completions).
# AI_PROVIDER=mistral  AI_API_KEY=...  AI_MODEL=mistral-small-latest
# AI_MAX_BATCHES caps the API calls per import review (default 5, 40 merchants each).
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=mistral-small-latest
AI_MAX_BATCHES=5

# How often a merchant must appear before the AI run proposes a rule for it.
# 3 = three rows within the last 12 months. One-off visits never earn a rule.
MIN_HITS_FOR_RULE=3

# Optional: refreshes ETF prices from Stooq (keyless) for broker accounts.
PRICE_FETCH=disabled
